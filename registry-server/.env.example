# Murmur Registry Server Environment Variables
# Upstash Redis Configuration (https://console.upstash.com)

# Copy these directly from your Upstash Database Dashboard -> REST API tab:
UPSTASH_REDIS_REST_URL=https://your-db-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=AX...your_upstash_rest_token...

# (Optional) Port for local server (defaults to 3000)
PORT=3000
